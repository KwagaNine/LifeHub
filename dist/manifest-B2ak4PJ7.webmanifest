{
  "name": "LifeHub",
  "short_name": "LifeHub",
  "description": "Личный центр для финансов, событий, заметок, целей и дома.",
  "lang": "ru",
  "start_url": "/standalone.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#f7f4ed",
