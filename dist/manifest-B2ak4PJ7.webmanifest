  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/lifehub-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": ["productivity", "finance", "lifestyle"],
  "shortcuts": [
    {
      "name": "Финансы",
